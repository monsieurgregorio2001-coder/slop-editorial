---
import Base from "../../layouts/Base.astro";
import { withBase, VIEW_BASE, formatCount } from "../../lib/text.js";
import { hold } from "../../lib/transitions";
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const wide = [800, 1200, 1600].map((w) => `${u(`img/hero-wide-${w}.webp`)} ${w}w`).join(", ");
const alt = "A neon sunset over violet peaks and a mirrored lake. Two chrome spheres float over the water. A floodlit wooden sign reads Sunseet Point, Open 24 hours of hours.";
---
<Base title="The Still · Slop Editorial" description="The Still is the first work in the exhibition. Stand in front of it, hold it, and watch your visitor number improve." mode="product" page="feed">
  <div class="page" transition:name="page" transition:animate={hold}>
    <section class="wrap still" data-stage aria-label="The Still, framed">
      <div class="still__frame frame frame--wide" transition:name="hero-still">
        <picture>
          <source srcset={wide} sizes="(max-width: 1200px) 100vw, 1120px" type="image/webp" />
          <img data-hero-img src={u("img/hero-wide-1200.webp")} width="1600" height="900" alt={alt} decoding="sync" fetchpriority="high" />
        </picture>
        <span class="ring" data-ring aria-hidden="true"></span>
      </div>
      <p class="still__line mono">
        <span class="still__reg" aria-hidden="true">Approved · <span data-viewed="the-still" data-base={VIEW_BASE["the-still"]}>Viewed {formatCount(VIEW_BASE["the-still"])} times</span></span>
        <span class="still__hold" data-hold-hint aria-hidden="true">Hold to appreciate</span>
      </p>
    </section>

    <section class="wrap spec" data-read aria-labelledby="spec-h">
      <div class="spec__label label">
        <div class="spec__row"><span class="plate">01</span><span class="sys">Landscape · Issue 001</span></div>
        <h1 id="spec-h" class="label__t spec__h">The Still</h1>
        <p class="label__k">Looks real. Count the fingers.</p>
        <p class="desc" data-cost>
          <span class="vh">I made this with my own hands. The hand has six fingers.</span>
          <span aria-hidden="true" data-cost-text>I made this with my own hands. The hand has <span class="ins" data-ins>six</span> fingers.</span>
        </p>
        <div class="prose spec__body">
          <p>This image took four seconds to generate and eleven minutes to approve. Nobody counted the fingers, the sign, or the spheres.</p>
          <p>The sign reads Sunseet Point and is open 24 hours of hours. The prompt is still printed at the bottom. Everyone said Amazing.</p>
        </div>
        <p class="label__note">The cost of being <span class="redact">[redacted]</span>. Taste not guaranteed.</p>
      </div>

      <div class="spec__side">
        <dl class="label__dl spec__dl">
          <dt>Medium</dt><dd>Generated image, 1672 × 941 px, 2026</dd>
          <dt>Edition</dt><dd>100% original · 1 of 48,291</dd>
          <dt>Prompt</dt><dd>ultra realistic, 8k, trending, masterpiece</dd>
          <dt>Price</dt><dd>Free · Limited availability</dd>
        </dl>
        <div class="spec__metrics">
          <div class="metric"><span class="metric__v"><span data-m-count="18">18</span> %</span><span class="metric__k">Engagement improved</span></div>
          <div class="metric"><span class="metric__v">0.8 s</span><span class="metric__k">Preferred by people who skip</span></div>
          <div class="metric"><span class="metric__v">Well</span><span class="metric__k">This image performed</span></div>
          <div class="metric"><span class="metric__v" data-views>184</span><span class="metric__k">Most viewed image, this week</span></div>
        </div>
      </div>
    </section>

    <hr class="rule wrap" />

    <section class="wrap section--tight next" aria-label="Next work">
      <a class="next__link" href={u("authenticity/")} data-next>
        <span class="sys">Next · 09 · USD 14.99 · Free shipping on redemption</span>
        <span class="h2 next__title">Certificate of Human Touch</span>
      </a>
    </section>
  </div>

  <script>
    import { initFeed } from "../../scripts/feed";
    document.addEventListener("astro:page-load", initFeed);
  </script>
</Base>

<style>
  .still { position: relative; display: grid; gap: 10px; padding-top: clamp(20px, 3vh, 32px); touch-action: pan-y; }
  .still__frame { overflow: clip; }
  .still__frame picture, .still__frame img { display: block; width: 100%; }
  .still__frame img { object-fit: cover; will-change: transform; }
  .ring { left: 50%; top: 50%; translate: -50% -50%; z-index: 4; }
  .still__line { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .still__hold { display: none; }
  @media (hover: none) { .still__hold { display: inline; } }

  .spec { padding-block: clamp(32px, 6vh, 64px); display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .spec__row { display: flex; align-items: center; gap: 12px; }
  .spec__h { font-size: clamp(30px, 3.6vw, 48px); }
  .desc { font: 500 clamp(18px, 1.5vw, 22px)/1.4 var(--display); letter-spacing: -.015em; }
  .desc .ins { display: inline-block; background: var(--accent); color: var(--bg); padding: 0 .22em; line-height: 1.2; }
  .desc .ins[data-off] { display: none; }
  .desc .ins[data-on] { animation: ins 500ms var(--ease) both; }
  @keyframes ins { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  .spec__body { font-size: 16px; color: var(--muted); }
  .redact { display: inline-block; background: var(--fg); color: var(--bg); padding: 0 .3em; }
  .spec__side { display: grid; gap: 28px; padding-top: 6px; }
  .spec__metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; padding-top: 20px; border-top: 1px solid var(--line); }

  .next__link { display: grid; gap: 8px; text-decoration: none; }
  .next__link:hover .next__title, .next__link:focus-visible .next__title { color: var(--accent); }
  @media (max-width: 900px) { .spec { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .ring { top: 40%; } }
</style>
