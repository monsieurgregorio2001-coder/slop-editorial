---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/text.js";
export async function getStaticPaths() {
  const all = await getCollection("releases");
  const works = await getCollection("works");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, work: works.find((w) => w.id === entry.data.work)! } }));
}
const { entry, work } = Astro.props;
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const d = entry.data;
const label: Record<string, string> = { DRAFT: "Draft", IN_REVIEW: "In review", READY: "Ready for a human", APPROVED: "Approved by a human" };
---
<Base title={`${d.id} ${d.title} · Releases · Slop Editorial`} description={d.brief} page="releases">
  <article class="wrap section rel">
    <div class="head">
      <p class="sys"><a href={u("releases/")}>Releases</a> / {d.id}</p>
      <h1 class="h1">{d.title}</h1>
      <p class="mono">{d.kind} · {d.window}</p>
    </div>
    <div class="rel__grid">
      <figure class="rel__fig frame frame--portrait">
        <img src={u(`img/${work.data.image}-480.webp`)} width="480" height="600" alt={work.data.alt} decoding="async" />
      </figure>
      <div class="rel__main">
        <h2 class="rel__h2">The gate</h2>
        <dl class="gate label__dl">
          <dt>State</dt><dd><span class="pill" data-tone={d.state.toLowerCase()}>{label[d.state]}</span></dd>
          <dt>Production</dt><dd>{d.production}</dd>
          <dt>Spend estimate</dt><dd>{d.estimate}</dd>
          <dt>Spend cap</dt><dd>{d.cap}</dd>
          <dt>Approval</dt><dd>{d.approval}</dd>
          <dt>Destination</dt><dd>{d.destination}</dd>
        </dl>
        <h2 class="rel__h2">Caption, as it would post</h2>
        <p class="cap">{d.caption}</p>
        <h2 class="rel__h2">Alt text</h2>
        <p class="label__note">{work.data.alt}</p>
        <h2 class="rel__h2">Open before any release</h2>
        <ul class="open">{d.open.map((o: string) => <li>{o}</li>)}</ul>
        <p class="label__note" data-sample>Sample data. Nothing on this page grants an approval. <a href={u("queue/")}>See the queue</a>.</p>
      </div>
    </div>
  </article>
</Base>

<style>
  .rel { display: grid; gap: 12px; }
  .rel__grid { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  .rel__fig { margin: 0; }
  .rel__main { display: grid; gap: 12px; max-width: 64ch; }
  .rel__h2 { font: 600 18px/1.2 var(--display); letter-spacing: -.02em; margin-top: 14px; }
  .gate dd { line-height: 1.7; }
  .cap { font: 500 20px/1.3 var(--display); letter-spacing: -.015em; }
  .open { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  @media (max-width: 760px) { .rel__grid { grid-template-columns: 1fr; } .rel__fig { max-width: 300px; } }
</style>
