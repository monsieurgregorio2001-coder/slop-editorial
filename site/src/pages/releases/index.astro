---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/text.js";
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const rel = (await getCollection("releases")).sort((a, b) => a.data.order - b.data.order);
const done = rel.filter((r) => r.data.state === "APPROVED").length;
const pct = Math.round((done / rel.length) * 100);
const label: Record<string, string> = { DRAFT: "Draft", IN_REVIEW: "In review", READY: "Ready for a human", APPROVED: "Approved by a human" };
const waiting = rel.filter((r) => r.data.state === "READY").length;
---
<Base title="Releases · Slop Editorial" description="The release tracker: every sample issue and the human gate it waits behind." page="releases">
  <section class="wrap section run">
    <div class="head">
      <p class="sys">Release tracker · November sample run · Human-in-the-loop gates</p>
      <h1 class="h1">Your November is {pct} % approved.</h1>
      <p class="lede">{done} of {rel.length} releases approved. {waiting} ready for a human. Nothing ships on its own.</p>
      <div class="track" role="img" aria-label={`${pct} percent approved`}><i style={`width:${pct}%`}></i></div>
      <p class="mono run__links"><a href={u("queue/")}>Approval queue</a></p>
    </div>

    <ol class="slots">
      {rel.map((r) => (
        <li class="slot" data-tone={r.data.state.toLowerCase()}>
          <a class="slot__link" href={u(`releases/${r.id}/`)}>
            <span class="mono slot__id">{r.data.id}</span>
            <span class="slot__main">
              <span class="slot__t">{r.data.title}</span>
              <span class="mono">{r.data.kind} · {r.data.window}</span>
            </span>
            <span class="slot__status"><span class="pill" data-tone={r.data.state.toLowerCase()}>{label[r.data.state]}</span><span class="mono">{r.data.production}</span></span>
            <span class="mono slot__price">{r.data.price === "0.00" ? "Free" : r.data.price}</span>
          </a>
        </li>
      ))}
    </ol>

    <aside class="blocker" aria-label="Needs a human">
      <span class="pill" data-tone="approved">Spend is capped</span>
      <p class="label__note">Every release shows an estimate, a cap and an approval reference. The pipeline refuses to spend without all three. A human also counts the fingers. All figures are sample data from the free mock provider.</p>
    </aside>

    <div class="run__foot">
      <a class="btn btn--primary" href={u("queue/")}>Review the approval queue</a>
      <p class="label__note">States and windows are planning, not publication. Prices are the work.</p>
    </div>
  </section>
</Base>

<style>
  .run { display: grid; gap: 28px; min-height: 70svh; align-content: start; }
  .track { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; max-width: 420px; margin-top: 8px; }
  .track i { display: block; height: 100%; background: var(--positive); }
  .run__links a { text-decoration: none; color: var(--fg); }
  .run__links a:hover { color: var(--accent); }
  .slots { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  .slot__link { display: grid; grid-template-columns: 3rem minmax(0, 1.4fr) minmax(0, 1fr) auto; gap: 12px 24px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .slot__main, .slot__status { display: grid; gap: 6px; justify-items: start; }
  .slot__t { font: 600 clamp(18px, 1.8vw, 22px)/1.2 var(--display); letter-spacing: -.02em; }
  .slot__link:hover .slot__t { color: var(--accent); }
  .slot__price { color: var(--fg); }
  .blocker { display: grid; gap: 10px; justify-items: start; padding: 18px 20px; border: 1px solid var(--line); border-radius: 10px; max-width: 70ch; }
  .run__foot { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .run__foot .label__note { flex-basis: 100%; }
  @media (max-width: 720px) { .slot__link { grid-template-columns: 2.4rem 1fr auto; } .slot__status { grid-column: 2; } .slot__price { grid-column: 3; grid-row: 1; } }
</style>
