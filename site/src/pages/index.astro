---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { withBase, VIEW_BASE, formatCount } from "../lib/text.js";
import { catalogue } from "../lib/catalogue";
import { hold } from "../lib/transitions";
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const wide = [800, 1200, 1600].map((w) => `${u(`img/hero-wide-${w}.webp`)} ${w}w`).join(", ");
const pieces = await catalogue();
const showing = pieces.filter((p) => ["02", "06", "09"].includes(p.n));
const releases = (await getCollection("releases")).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const status: Record<string, string> = { DRAFT: "Draft", IN_REVIEW: "In review", READY: "Ready for a human", APPROVED: "Approved" };
const alt = "A neon sunset over violet peaks and a mirrored lake. Two chrome spheres float over the water. A floodlit wooden sign reads Sunseet Point, Open 24 hours of hours.";
---
<Base title="Slop Editorial" description="Slop Editorial. Generation is cheap. Taste is not. A deadpan satire of AI content and the attention economy, hung like an exhibition." mode="product" page="home">
  <div class="page" transition:name="page" transition:animate={hold}>

    <section class="cover wrap" data-cover aria-label="Cover">
      <h1 class="vh">Slop Editorial. Generation is cheap. Taste is not.</h1>
      <div class="cover__mast">
        <span class="cover__word mark" role="img" aria-label="Slop Editorial" style={`--src:url(${u("wordmark.svg")})`}></span>
        <p class="cover__pos">A satire of AI slop, hung like an exhibition.</p>
      </div>

      <a class="cover__stage frame frame--wide" id="room-hero" href={u("feed/")} data-hero-link data-stage>
        <div class="cover__img" transition:name="hero-still">
          <picture>
            <source srcset={wide} sizes="(max-width: 1200px) 100vw, 1120px" type="image/webp" />
            <img src={u("img/hero-wide-1200.webp")} width="1600" height="900" alt={alt} decoding="async" fetchpriority="high" />
          </picture>
        </div>
        <span class="sticker cover__sticker" data-sticker>Free.<small>Limited availability.</small></span>
      </a>

      <div class="cover__label label">
        <div class="cover__row">
          <span class="plate">01</span>
          <p class="label__t cover__title">The Still</p>
        </div>
        <dl class="label__dl">
          <dt>Medium</dt><dd>Generated image, 1672 × 941 px, 2026</dd>
          <dt>Edition</dt><dd>100% original · 1 of 48,291</dd>
          <dt>Prompt</dt><dd class="cover__sub">ultra realistic, 8k, trending, masterpiece</dd>
          <dt>Record</dt><dd class="cover__meta">Issue 001 · ★ 4.2 · <span data-viewed="the-still" data-base={VIEW_BASE["the-still"]}>Viewed {formatCount(VIEW_BASE["the-still"])} times</span></dd>
        </dl>
        <p class="label__note">Open 24 hours of hours. The sign is the only thing in the picture that read its own copy.</p>
        <p class="mono cover__dwell" data-dwell aria-hidden="true"></p>
      </div>
    </section>

    <hr class="rule wrap" />

    <section class="wrap section" aria-labelledby="showing-h">
      <div class="head head--row">
        <h2 id="showing-h" class="h2">Now showing</h2>
        <a class="ui more" href={u("works/")}>All nine works</a>
      </div>
      <ul class="grid grid--three">
        {showing.map((p) => (
          <li>
            <a class="tile" href={u(p.href)}>
              <span class="frame frame--portrait"><img src={u(`img/${p.image}-800.webp`)} width="800" height="1000" alt={p.alt} loading="lazy" decoding="async" /></span>
              <span class="tile__cap"><span class="plate">{p.n}</span><span class="tile__t">{p.title}</span><span class="tile__m">{p.meta}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <hr class="rule wrap" />

    <section class="wrap section" aria-labelledby="gate-h">
      <div class="head head--row">
        <h2 id="gate-h" class="h2">Every piece waits for a human</h2>
        <a class="ui more" href={u("releases/")}>Release tracker</a>
      </div>
      <ul class="avail">
        {releases.map((r) => (<li class="avail__row"><span class="avail__t">{r.data.title}</span><span class="mono">{r.data.window}</span><span class="mono avail__s" data-tone={r.data.state.toLowerCase()}>{status[r.data.state]}</span></li>))}
      </ul>
      <p class="label__note">Sample slate. Nothing ships on its own. A person counts the fingers, reads the sign and signs the approval.</p>
    </section>
    <span hidden data-warm data-srcset={wide} data-src={u("img/hero-wide-1200.webp")}></span>
  </div>

  <script>
    import { initHome } from "../scripts/home";
    document.addEventListener("astro:page-load", initHome);
  </script>
</Base>

<style>
  .cover { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(16px, 3vh, 32px); padding-top: clamp(16px, 3vh, 40px); padding-bottom: clamp(40px, 7vh, 72px); }
  .cover__mast { display: grid; gap: 8px; }
  .cover__word { width: clamp(180px, 26vw, 360px); aspect-ratio: 251 / 52; color: var(--fg); }
  .cover__pos { font: 600 clamp(16px, 1.5vw, 20px)/1.25 var(--display); letter-spacing: -.015em; color: var(--muted); max-width: 40ch; text-wrap: balance; }
  .cover__stage { text-decoration: none; color: inherit; }
  .cover__img { overflow: clip; }
  .cover__img picture, .cover__img img { display: block; width: 100%; }
  .cover__img img { object-fit: cover; max-height: 62vh; }
  .cover__stage:hover .cover__img img { filter: saturate(1.04); }
  .cover__sticker { position: absolute; right: clamp(22px, 4vw, 48px); top: clamp(22px, 3vw, 40px); z-index: 2; font-size: clamp(22px, 2.6vw, 38px); text-align: center; }
  .cover__sticker small { display: block; font: 700 .32em/1.1 var(--text); text-transform: uppercase; letter-spacing: .06em; margin-top: .25em; }
  .cover__label { grid-template-columns: minmax(0, 1fr); max-width: 64ch; }
  .cover__row { display: flex; align-items: center; gap: 12px; }
  .cover__title { font-size: clamp(24px, 2.4vw, 34px); }
  .cover__dwell:empty { display: none; }
  .cover__dwell { color: var(--accent); }
  /* From 900 px the wall label hangs beside the plate, so both sit above the fold at 1440 by 900. */
  @media (min-width: 900px) {
    .cover { grid-template-columns: minmax(0, 1.9fr) minmax(260px, 1fr); column-gap: clamp(24px, 3vw, 48px); align-items: start; }
    .cover__mast { grid-column: 1 / -1; }
    .cover__label { padding-top: 8px; }
  }

  .head--row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .more { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .more:hover { color: var(--accent); }
  .grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .avail { list-style: none; margin: 0 0 20px; padding: 0; display: grid; border-top: 1px solid var(--line); }
  .avail__row { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .avail__t { font: 600 16px/1.3 var(--display); letter-spacing: -.01em; }
  .avail__s[data-tone="approved"], .avail__s[data-tone="ready"] { color: var(--positive); }
  @media (max-width: 760px) { .grid--three { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .cover__word { width: min(60vw, 240px); }
    .cover__sticker { right: 14px; top: 14px; font-size: 18px; }
    .avail__row { grid-template-columns: 1fr; gap: 2px; }
    .grid--three { grid-template-columns: 1fr; }
  }
</style>
