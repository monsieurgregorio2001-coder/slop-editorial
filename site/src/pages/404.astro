---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/text.js";
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
---
<Base title="Not found · Slop Editorial" description="This page was not found." page="404">
  <section class="wrap section nf">
    <p class="sys">404</p>
    <h1 class="h1">Page not found.</h1>
    <p class="lede">I am sorry, but I cannot fulfill this request. Certainly! Here is a link home.</p>
    <p><a class="btn" href={u()}>Back to the front</a></p>
  </section>
</Base>
<style>
  .nf { display: grid; gap: 16px; justify-items: start; min-height: 60svh; align-content: start; }
</style>
