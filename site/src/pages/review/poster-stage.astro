---
// Offline render target for scripts/render-poster.mjs. Not linked anywhere.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Offline render target for the poster frames." />
    <title>Poster stage</title>
    <style>
      html, body { margin: 0; background: #0e0b1f; }
      #stage { width: 640px; height: 800px; background: radial-gradient(120% 80% at 50% 38%, #221a44 0%, #0e0b1f 62%); }
    </style>
  </head>
  <body>
    <div id="stage"></div>
    <script>
      import { mountSeal } from "../../scripts/seal-scene";
      (async () => {
        const h = await mountSeal(document.getElementById("stage")!, { tier: "webgl", dpr: 1 });
        h.setAuto(false); h.setLight(1);
        (window as any).__sealPose = (a: number) => h.setPose(a);
        (window as any).__sealReady = true;
      })();
    </script>
  </body>
</html>
