---
import Base from "../../layouts/Base.astro";
import ModeBlock from "../../components/ModeBlock.astro";
import { withBase } from "../../lib/text.js";
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const items = [
  { n: "01", t: "The front of the gallery", href: "", look: "A masthead, the still in a frame, and a wall label that reads like a museum card. Your visitor number sits in one quiet line under the navigation. The cookie sheet offers Accept all and Accept all." },
  { n: "02", t: "Beautiful, then wrong", href: "feed/", look: "Open The Still. The label lists the medium, the edition and the prompt. Then the metrics arrive. Engagement improved 18 %. Preferred by people who skip. This image performed well." },
  { n: "03", t: "One interface joke", href: "feed/", look: "Your taste has 1 update available, to delve into the rich tapestry of what you already like. Not now sets a reminder. Install ends with Installed. No visible difference." },
  { n: "04", t: "One embarrassment", href: "feed/", look: "Stand still in front of the image for seven seconds. The system says: You have been looking for 0:07. That is above average. The sixth finger goes unmentioned." },
  { n: "05", t: "One banal object ruining luxury", href: "authenticity/", look: "A gilded certificate turns on a plinth. Then the gift shop arrives in front of it. It brings a barrier, a laminated PLEASE DO NOT GENERATE, and sanitizer. The terminal reads TAP TO APPRECIATE 2.00. A prompt pack is 14.99 and an extra finger is 2.99." },
  { n: "06", t: "A catalogue, not a feed", href: "works/", look: "The archive is an exhibition of nine works with a plate number, a rating, a view count and a price in each label. The buy bar adds prompt packs, and the receipt itemizes what you appreciated, including the watermark remover remover." },
  { n: "07", t: "The viewer becomes the joke", href: "feed/", look: "Every action improves your visitor number. Scroll, hold, install an update: the number drops and the system thanks you. Your taste has been updated." },
  { n: "08", t: "Mobile interaction", href: "feed/", look: "On a phone, hold the image. A ring fills in 0.9 s. Appreciation registered. Free shipping on redemption. One prompt pack is added." },
  { n: "09", t: "Reduced motion", href: "?motion=reduce", look: "Delays and staging collapse. Sticker, shop objects and buy bar sit in their finished state. Counters hold still. Nothing moves on its own." },
  { n: "10", t: "Unexpectedly playful", href: "authenticity/", look: "The gift shop works. The pack adds up, the receipt itemizes, and the reader is thanked for appreciating." },
];
---
<Base title="Review · Slop Editorial" description="An index of the ten behaviours, each a working page, plus the release tracker and the approval queue." page="review">
  <section class="wrap section rv">
    <div class="head">
      <p class="sys">Review index · Proof of concept</p>
      <h1 class="h1">Ten behaviours</h1>
      <p class="lede">Each behaviour is a working page. A still image is no longer evidence. The site may be unstable in tone and must never be unstable in engineering.</p>
    </div>
    <ol class="rv__list">
      {items.map((i) => (
        <li class="rv__item">
          <span class="plate">{i.n}</span>
          <a class="rv__t" href={u(i.href)}>{i.t}</a>
          <p class="label__note">{i.look}</p>
        </li>
      ))}
    </ol>

    <h2 class="h2 rv__h2">The human gate</h2>
    <p class="lede">The release tracker and the approval queue demonstrate human-in-the-loop control. The queue buttons refuse on purpose.</p>
    <p class="rv__links"><a class="btn" href={u("releases/")}>Release tracker</a> <a class="btn" href={u("queue/")}>Approval queue</a></p>

    <h2 class="h2 rv__h2">One component, five modes</h2>
    <p class="lede">The same block, reading its container width and re-pointing its own tokens.</p>
    <div class="modes">
      <ModeBlock mode="editorial" label="Editorial" note="Paper field, violet rule.">A publication for a more measured world.</ModeBlock>
      <ModeBlock mode="luxury" label="Luxury" note="Stage black, gold.">Engineered for sincerity.</ModeBlock>
      <ModeBlock mode="telemetry" label="Telemetry" note="Mono, uppercase, local.">Viewing behaviour: ordinary. Interest: logged.</ModeBlock>
      <ModeBlock mode="commercial" label="Commercial" note="Soft radius, sticker yellow.">Originality from 0/month.</ModeBlock>
      <ModeBlock mode="failure" label="Failure" note="Staged, never technical.">Review incomplete.</ModeBlock>
    </div>
  </section>
</Base>

<style>
  .rv { display: grid; gap: 24px; }
  .rv__h2 { margin-top: 32px; }
  .rv__list { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); }
  .rv__item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px 16px; padding: 20px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .rv__item p { grid-column: 2; }
  .rv__t { font: 600 clamp(18px, 1.8vw, 22px)/1.2 var(--display); letter-spacing: -.02em; text-decoration: none; }
  .rv__t:hover, .rv__t:focus-visible { color: var(--accent); }
  .rv__links { display: flex; gap: 12px; flex-wrap: wrap; }
  .modes { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 16px; }
</style>
