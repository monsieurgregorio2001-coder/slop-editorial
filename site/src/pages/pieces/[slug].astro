---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { readingMinutes } from "../../lib/text.js";
export async function getStaticPaths() {
  const pieces = await getCollection("pieces");
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toISOString().slice(0, 10);
---
<Base title={`${entry.data.title} | Slop Editorial`} description={entry.data.summary} page="piece">
  <article class="piece">
    <p class="label">{entry.data.kicker}</p>
    <h1>{entry.data.title}</h1>
    <p class="meta label"><time class="mono" datetime={date}>{date}</time><span class="mono">{readingMinutes(entry.body)} min read</span><span class="tag">Sample</span></p>
    <p class="notice" data-sample>Sample piece. Written for this portfolio demo and not published anywhere else.</p>
    <div class="body"><Content /></div>
  </article>
</Base>
