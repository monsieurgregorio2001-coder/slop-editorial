---
import Base from "../../layouts/Base.astro";
import { withBase, VIEW_BASE, formatCount } from "../../lib/text.js";
import { catalogue } from "../../lib/catalogue";
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const pieces = await catalogue();
---
<Base title="Works · Slop Editorial" description="The exhibition: nine generated works hung with wall labels, each with a plate number, a rating, a view count and a price." page="works">
  <section class="wrap section ex">
    <div class="head">
      <p class="sys">Exhibition · {pieces.length} works · Hung in order</p>
      <h1 class="h1">Works</h1>
      <p class="lede">Nine pictures nobody decided to make, each labelled as though someone had. Ratings and views live in this browser only.</p>
    </div>
    <ul class="grid">
      {pieces.map((p) => (
        <li>
          <a class="tile" href={u(p.href)} data-piece={p.n}>
            <span class={`frame ${p.image === "seal-poster" ? "frame--portrait" : "frame--portrait"}`}><img src={u(`img/${p.image}-800.webp`)} width="800" height="1000" alt={p.alt} loading={Number(p.n) <= 3 ? "eager" : "lazy"} decoding="async" /></span>
            <span class="tile__cap">
              <span class="plate">{p.n}</span>
              <span class="tile__t">{p.title}</span>
              <span class="tile__m">{p.viewed ? <><span>★ 4.2 · </span><span data-viewed={p.viewed} data-base={VIEW_BASE[p.viewed]}>Viewed {formatCount(VIEW_BASE[p.viewed])} times</span><span> · {p.n === "01" ? "Free" : "14.99"}</span></> : p.meta}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="label__note ex__note">Every work is a labelled sample. Nothing is for sale. The prices are the joke.</p>
  </section>
</Base>

<style>
  .ex { display: grid; gap: 8px; min-height: 70svh; align-content: start; }
  .ex .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 8px; }
  .ex__note { margin-top: clamp(24px, 4vh, 40px); }
  @media (max-width: 760px) { .ex .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .ex .grid { grid-template-columns: 1fr; } }
</style>
