---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/text.js";
export async function getStaticPaths() {
  const all = await getCollection("works");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const d = entry.data;
const srcset = [480, 800, 1000].map((w) => `${u(`img/${d.image}-${w}.webp`)} ${w}w`).join(", ");
---
<Base title={`${d.title} · Slop Editorial`} description={d.kicker} page="works">
  <article class="work" data-work={entry.id}>
    <figure class="work__fig">
      <picture>
        <source srcset={srcset} sizes="(max-width: 900px) 100vw, 520px" type="image/webp" />
        <img src={u(`img/${d.image}-800.webp`)} width="1000" height="1250" alt={d.alt} fetchpriority="high" decoding="async" />
      </picture>
    </figure>
    <div class="work__body">
      <p class="sys">{d.topic} · No {String(d.rank).padStart(2, "0")}</p>
      <h1 class="work__h">{d.title}</h1>
      <p class="work__k">{d.kicker}</p>
      <div class="work__text"><Content /></div>
      <dl class="work__meta">
        <div><dt>Rating</dt><dd>★ {d.rating} · {d.ratings} ratings</dd></div>
        <div><dt>Views</dt><dd>{d.views}</dd></div>
        <div><dt>Availability</dt><dd>{d.availability}</dd></div>
        <div><dt>Price</dt><dd><span class="sticker">{d.price}</span></dd></div>
      </dl>
      <p class="ui">People like you also scrolled: {d.also}.</p>
      <p class="ui" data-sample>Sample work. Original image generated in code, original text, no photographs.</p>
      <p><a class="btn" href={u("works/")}>Back to inventory</a></p>
    </div>
  </article>
  <script>
    import { view } from "../../scripts/system";
    document.addEventListener("astro:page-load", () => {
      const id = document.querySelector<HTMLElement>("[data-work]")?.dataset.work;
      if (id) view(id);
    });
  </script>
</Base>

<style>
  .work { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); padding: clamp(32px, 6vh, 80px) var(--gutter) clamp(60px, 12vh, 120px); align-items: start; }
  .work__fig { border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--line); }
  .work__fig img { width: 100%; height: 100%; object-fit: cover; }
  .work__body { display: grid; gap: 18px; max-width: 62ch; }
  .work__h { font: 800 clamp(40px, 5.4vw, 80px)/.98 var(--display); letter-spacing: -.04em; }
  .work__k { font: 600 clamp(18px, 1.8vw, 24px)/1.3 var(--display); color: var(--accent); }
  .work__text { font-size: 18px; line-height: 1.6; }
  .work__meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 24px; margin: 8px 0; }
  .work__meta dt { font: 500 12px/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .work__meta dd { margin: 2px 0 0; font-weight: 600; }
  .work__meta .sticker { font-size: 20px; }
  @media (max-width: 860px) { .work { grid-template-columns: 1fr; } .work__fig { max-width: 520px; } }
</style>
