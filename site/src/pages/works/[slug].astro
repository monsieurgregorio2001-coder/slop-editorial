---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { withBase, priceLabel } from "../../lib/text.js";
import { catalogue, plateFor } from "../../lib/catalogue";
export async function getStaticPaths() {
  const all = await getCollection("works");
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const u = (p = "") => withBase(import.meta.env.BASE_URL, p);
const d = entry.data;
const srcset = [480, 800, 1000].map((w) => `${u(`img/${d.image}-${w}.webp`)} ${w}w`).join(", ");
const pieces = await catalogue();
const n = plateFor(d.order);
const i = pieces.findIndex((p) => p.n === n);
const prev = pieces[i - 1];
const next = pieces[i + 1];
---
<Base title={`${d.title} · Slop Editorial`} description={d.kicker} page="works">
  <article class="wrap section work" data-work={entry.id}>
    <figure class="work__fig frame frame--portrait">
      <picture>
        <source srcset={srcset} sizes="(max-width: 860px) 100vw, 560px" type="image/webp" />
        <img src={u(`img/${d.image}-800.webp`)} width="1000" height="1250" alt={d.alt} fetchpriority="high" decoding="async" />
      </picture>
    </figure>
    <div class="work__body label">
      <div class="work__row"><span class="plate">{n}</span><span class="sys">{d.topic}</span></div>
      <h1 class="label__t work__h">{d.title}</h1>
      <p class="label__k">{d.kicker}</p>
      <div class="work__text prose"><Content /></div>
      <dl class="label__dl">
        <dt>Medium</dt><dd>Generated image, 1122 × 1402 px, 2026</dd>
        <dt>Rating</dt><dd>★ {d.rating} · {d.ratings} ratings</dd>
        <dt>Views</dt><dd>{d.views}</dd>
        <dt>Status</dt><dd>{d.availability}</dd>
        <dt>Price</dt><dd>{priceLabel(d.price)}</dd>
      </dl>
      <p class="label__note">People like you also scrolled: {d.also}.</p>
      <p class="label__note" data-sample>Sample work. Image generated from a written brief with an image model, then checked by a person against that brief. Original text.</p>
      <nav class="work__nav" aria-label="Exhibition order">
        {prev ? <a href={u(prev.href)}><span class="sys">Previous</span><span>{prev.n} {prev.title}</span></a> : <span></span>}
        <a href={u("works/")}><span class="sys">Index</span><span>All works</span></a>
        {next ? <a href={u(next.href)}><span class="sys">Next</span><span>{next.n} {next.title}</span></a> : <span></span>}
      </nav>
    </div>
  </article>
  <script>
    import { view } from "../../scripts/system";
    document.addEventListener("astro:page-load", () => {
      const id = document.querySelector<HTMLElement>("[data-work]")?.dataset.work;
      if (id) view(id);
    });
  </script>
</Base>

<style>
  .work { display: grid; grid-template-columns: minmax(0, 560px) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .work__fig { margin: 0; }
  .work__body { gap: 14px; max-width: 60ch; }
  .work__row { display: flex; align-items: center; gap: 12px; }
  .work__h { font-size: clamp(28px, 3.2vw, 44px); }
  .work__text { font-size: 16px; }
  .work__nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }
  .work__nav a { display: grid; gap: 2px; text-decoration: none; font: 500 14px/1.35 var(--text); }
  .work__nav a:hover { color: var(--accent); }
  .work__nav a:nth-child(2) { text-align: center; }
  .work__nav a:nth-child(3) { text-align: right; }
  @media (max-width: 860px) { .work { grid-template-columns: 1fr; } .work__fig { max-width: 560px; } }
</style>
