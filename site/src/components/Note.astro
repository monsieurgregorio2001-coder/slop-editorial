---
// One component, three editorial modes. The block reads its own container width
// (container queries) and re-points the token set locally.
interface Props { mode: "note" | "evidence" | "counterpoint"; label: string; }
const { mode, label } = Astro.props;
---
<aside class="note" data-mode={mode}>
  <p class="note__label">{label}</p>
  <div class="note__body"><slot /></div>
</aside>

<style>
  .note { container-type: inline-size; margin: 1.6em 0; padding: clamp(14px, 3cqi, 24px); background: var(--nbg); color: var(--nfg); border: 1px solid var(--rule); border-left: 3px solid var(--naccent); border-radius: var(--radius-card); }
  .note[data-mode="note"] { --nbg: var(--accent-wash); --nfg: var(--ink); --naccent: var(--accent); }
  .note[data-mode="evidence"] { --nbg: var(--ink); --nfg: var(--paper); --naccent: var(--paper); }
  .note[data-mode="counterpoint"] { --nbg: var(--surface); --nfg: var(--ink); --naccent: var(--warning); }
  .note__label { margin: 0 0 8px; font: 600 var(--step--2)/1.4 var(--text); letter-spacing: .04em; text-transform: uppercase; color: var(--nfg); opacity: .78; }
  .note__body :global(p) { margin: 0; font-size: clamp(16px, 4.4cqi, 19px); line-height: 1.5; }
  .note[data-mode="evidence"] .note__body :global(p) { font-family: var(--mono); font-size: clamp(14px, 3.6cqi, 16px); }
</style>
