---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { withBase } from "../lib/text.js";
import interUrl from "../assets/fonts/inter-latin-wght-normal.woff2?url";
import displayUrl from "../assets/fonts/bricolage-grotesque-latin-wght-normal.woff2?url";
interface Props {
  title: string;
  description?: string;
  mode?: "product" | "luxury" | "telemetry";
  page: string;
  noindex?: boolean;
}
const { title, description = "Slop Editorial. Generation is cheap. Taste is not. A satire of AI content and the attention economy.", mode = "product", page, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p = "") => withBase(base, p);
const REPO = "https://github.com/monsieurgregorio2001-coder/slop-editorial";
const ogImage = Astro.site ? new URL(u("og.png"), Astro.site).href : u("og.png");
const nav: Array<[string, string, string]> = [
  ["works", "Works", "works/"],
  ["authenticity", "Certificate", "authenticity/"],
  ["releases", "Releases", "releases/"],
  ["about", "Method", "about/"],
];
---
<!doctype html>
<html lang="en" data-room="slop-editorial" data-mode={mode} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={u("favicon.svg")} />
    <!-- house:boot --><!-- /house:boot -->
    <link rel="stylesheet" href="/house/2.0.0/tokens.css" />
    <link rel="stylesheet" href="/house/2.0.0/house.css" />
    <script is:inline src="/house/2.0.0/doorway.js"></script>
    <script is:inline type="module" src="/house/2.0.0/house.js"></script>
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <!-- Motion and room preferences are applied before first paint. -->
    <script is:inline>
      (function () {
        try {
          var r = document.documentElement;
          r.setAttribute("data-js", "");
          var q = new URLSearchParams(location.search).get("motion");
          var s = JSON.parse(localStorage.getItem("slop.session") || "{}");
          var forced = q === "reduce" || (q !== "auto" && s.motion === "reduce");
          var rm = forced || matchMedia("(prefers-reduced-motion: reduce)").matches || r.dataset.motion === "calm";
          if (rm) r.setAttribute("data-rm", "");
          // No stored choice means the room follows the OS colour scheme.
          if (s.theme === "dark") r.dataset.theme = "dark";
          else if (s.theme === "paper") r.dataset.theme = "light";
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="house-skip" href="#main">Skip to content</a>
    <div class="house-slot" transition:persist="house-crumb"><!-- house:crumb --><!-- /house:crumb --></div>
    <div class="shell">
      <div class="shell__in">
        <nav class="shell__nav" aria-label="Slop Editorial">
          {nav.map(([id, label, href]) => <a href={u(href)} aria-current={page === id ? "page" : undefined}>{label}</a>)}
        </nav>
      </div>
    </div>
    <!-- The visitor line: staged measurement in one quiet row. Local only, hidden from assistive tech because it is theatre. -->
    <p class="visitor" aria-hidden="true" transition:persist="hud"><span data-hud-id>Visitor no. 184 today</span><span class="visitor__notice" data-hud-notice></span></p>
    <!-- The one joke every visitor gets. No cookie is set and both buttons agree. -->
    <div class="sheet" data-cookies hidden role="dialog" aria-label="Cookies" transition:persist="cookies">
      <p>Slop Editorial uses cookies to improve your experience of being measured. <small>No cookie is set. The counters live in this browser and never leave it.</small></p>
      <div class="sheet__row"><button class="btn" type="button" data-accept>Accept all</button><button class="btn btn--primary" type="button" data-accept>Accept all</button></div>
    </div>
    <div data-dialog-host transition:persist="dialog"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <section class="foot" aria-label="About this room">
      <div class="foot__in">
        <p>Slop Editorial is a portfolio satire. Every image was generated from a written brief with an image model, then checked by a person against that brief. Counters live in this browser only, and nothing leaves this device.</p>
        <p class="foot__links">
          <span>Built by Garfield Greg Lim III</span>
          <a href={REPO} rel="noopener">Code</a>
          <a href={u("OFL.txt")}>Font licenses</a>
        </p>
        <div class="foot__row">
          <button type="button" data-theme-toggle aria-pressed="false">Room: paper</button>
          <button type="button" data-motion-toggle aria-pressed="false">Motion: full</button>
          <button type="button" data-sound-toggle aria-pressed="false">Sound: off</button>
        </div>
      </div>
    </section>
    <div class="house-slot" transition:persist="house-footer"><!-- house:footer --><!-- /house:footer --></div>
    <script>
      import { applyMotionPreference, applyTheme } from "../scripts/system";
      import "../scripts/sound";
      import { initIntent } from "../scripts/intent";
      applyMotionPreference();
      document.addEventListener("astro:after-swap", () => { applyMotionPreference(); applyTheme(); });
      // Links to the house and to other rooms leave this site's router: the browser navigates, so the doorway can run.
      // The persisted footer keeps its Plain text link, so it is pointed at the current page every time.
      const leave = () => {
        const base = import.meta.env.BASE_URL;
        document.querySelectorAll<HTMLAnchorElement>("a[data-house-plain]").forEach((a) => { a.href = location.pathname.replace(/[^/]*$/, "") + "index.md"; a.setAttribute("data-astro-reload", ""); });
        document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((a) => { if (!(a.getAttribute("href") ?? "").startsWith(base)) a.setAttribute("data-astro-reload", ""); });
      };
      document.addEventListener("astro:page-load", leave);
      document.addEventListener("astro:page-load", initIntent);
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        const url = import.meta.env.BASE_URL + "sw.js";
        const reg = () => navigator.serviceWorker.register(url, { scope: import.meta.env.BASE_URL }).catch(() => {});
        if (document.readyState === "complete") reg(); else window.addEventListener("load", reg, { once: true });
      }
    </script>
  </body>
</html>
