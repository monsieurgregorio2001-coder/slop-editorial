---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { withBase } from "../lib/text.js";
import interUrl from "../assets/fonts/inter-latin-wght-normal.woff2?url";
import frauncesUrl from "../assets/fonts/fraunces-latin-opsz-normal.woff2?url";

interface Props { title: string; description?: string; page: string; }
const { title, description = "Slop Editorial: a sample publication about AI-generated content and editorial taste.", page } = Astro.props;
const base = import.meta.env.BASE_URL;
const HUB = "https://monsieurgregorio2001-coder.github.io/";
const REPO = "https://github.com/monsieurgregorio2001-coder/slop-editorial";
const ogImage = Astro.site ? new URL(withBase(base, "og.png"), Astro.site).href : withBase(base, "og.png");
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase(base, "favicon.svg")} />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <!-- Motion preference is applied before first paint so a reduced-motion reader never sees a transition. -->
    <script is:inline>
      (function () {
        try {
          var r = document.documentElement;
          var q = new URLSearchParams(location.search).get("motion");
          var s = JSON.parse(localStorage.getItem("slop.session") || "{}");
          var forced = q === "reduce" || (q !== "auto" && s.motion === "reduce");
          if (forced || matchMedia("(prefers-reduced-motion: reduce)").matches) r.setAttribute("data-rm", "");
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="shell" transition:persist="shell">
      <div class="shell__in">
        <div class="crumb">
          <a class="crumb__me" href={HUB}>Garfield Lim</a>
          <span class="crumb__slash" aria-hidden="true">/</span>
          <a class="crumb__proj" href={withBase(base)} aria-label="Slop Editorial, home">
            <img src={withBase(base, "logo.svg")} width="20" height="20" alt="" />
            <span>Slop Editorial</span>
          </a>
        </div>
        <nav class="shell__right" aria-label="Primary">
          <a href={withBase(base, "about/")} aria-current={page === "about" ? "page" : undefined}>Method</a>
          <a href={REPO} rel="noopener">Code</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <div class="foot__in">
        <p>Slop Editorial is a portfolio demo. Every piece is a labelled sample, and the site sets no cookies and runs no analytics.</p>
        <p class="foot__links">
          <span>Built by Garfield Greg Lim III</span>
          <a href={HUB}>Portfolio</a>
          <a href="https://github.com/monsieurgregorio2001-coder" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/garfield-lim-8239242a9" rel="noopener">LinkedIn</a>
          <a href="mailto:lim.ggreg@outlook.com">lim.ggreg@outlook.com</a>
        </p>
        <button type="button" data-motion-toggle aria-pressed="false">Motion: full</button>
      </div>
    </footer>
    <script>
      import { applyMotionPreference } from "../scripts/system";
      import { initIntent } from "../scripts/intent";
      applyMotionPreference(true);
      document.addEventListener("astro:after-swap", () => applyMotionPreference());
      document.addEventListener("astro:page-load", initIntent);
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        const url = import.meta.env.BASE_URL + "sw.js";
        const reg = () => navigator.serviceWorker.register(url, { scope: import.meta.env.BASE_URL }).catch(() => {});
        if (document.readyState === "complete") reg(); else window.addEventListener("load", reg, { once: true });
      }
    </script>
  </body>
</html>
